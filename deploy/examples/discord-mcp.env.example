# Non-secret settings for the server, stored as the SSM parameter
# /discord-mcp/env (see deploy/README.md, step 2).
#
# Copy this file OUTSIDE the repo, replace every <...>, then upload it. Left
# unfilled, the server refuses to start: fetch-params.sh rejects the < and >.
#
# Rules (checked by fetch-params.sh on every start):
# - one KEY=value per line; blank lines and lines starting with # are skipped
# - only the keys below, each at most once
# - values use only letters, digits and . _ : / , @ + -
#   (no spaces, quotes, $ or #)

# The host name Claude connects to, lower case. DNS points it at the
# instance's Elastic IP (step 9).
DOMAIN=<domain>

# Must be exactly https:// followed by DOMAIN.
PUBLIC_URL=https://<domain>

# The Discord server's ID (with Developer Mode on, right-click
# the server > Copy Server ID).
DISCORD_GUILD_ID=<server id>

# The Discord application's ID (Developer Portal > your app > OAuth2 >
# Client ID). Not secret.
DISCORD_CLIENT_ID=<discord application id>

# The client ID you type into claude.ai when adding the connector. Any name
# you choose, e.g. claude-t4d. Not secret; its secret is OAUTH_CLIENT_SECRET.
OAUTH_CLIENT_ID=<client id given to Claude>

# Where Claude's sign-in returns. These are Claude's fixed callback URLs;
# leave them as they are.
OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback

# Optional: the name the server reports to Claude (default discord-mcp).
# SERVER_NAME=discord-mcp
